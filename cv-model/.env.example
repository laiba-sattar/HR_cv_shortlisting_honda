# Copy this file to .env and fill it in. Never commit .env — it holds keys.

# ===========================================================================
# LLM — used for CV extraction and skill-transferability reasoning
# ===========================================================================
# Pick ONE of the blocks below and uncomment it.

# --- Groq (free tier, fast, easiest to start with) -------------------------
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=gsk_your_key_here
# Get a key at https://console.groq.com/keys
# IMPORTANT: Groq retires models regularly. If you get a 404 'model_not_found',
# check https://console.groq.com/docs/models for the current ID and update this.
# Alternatives that work today: qwen/qwen3.6-27b

# --- xAI (Grok) ------------------------------------------------------------
# LLM_PROVIDER=grok
# LLM_MODEL=grok-4
# LLM_API_KEY=xai-your_key_here

# --- OpenAI ----------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY=sk-your_key_here

# --- Anthropic -------------------------------------------------------------
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
# LLM_API_KEY=sk-ant-your_key_here

# --- Self-hosted: nothing leaves your machine ------------------------------
# Install Ollama from https://ollama.com, then: ollama pull qwen2.5:7b-instruct
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_BASE_URL=http://localhost:11434/v1

# --- Any other OpenAI-compatible endpoint (vLLM, OpenRouter, Together…) -----
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=your-model
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_API_KEY=your_key

# --- No API key: replays the 5 bundled sample CVs only ---------------------
# JD analysis still works on ANY real job description (rule-based).
# LLM_PROVIDER=fixture

LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# ===========================================================================
# Embeddings — semantic skill matching. Runs locally, no API key needed.
# ===========================================================================
EMBED_PROVIDER=sentence_transformers
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Production candidates — benchmark with check_semantics.py before switching:
# EMBED_MODEL=BAAI/bge-m3
# EMBED_MODEL=jinaai/jina-embeddings-v4

# ===========================================================================
# Thresholds — tune against check_semantics.py, not by guesswork
# ===========================================================================
SKILL_MATCH_THRESHOLD=0.72
SKILL_CONSIDER_THRESHOLD=0.30
EXPERIENCE_RELEVANCE_FLOOR=0.35

# ===========================================================================
# Speed. Both of these trade cost/latency against how hard the system tries
# to recognise a skill written in unfamiliar words.
# ===========================================================================
# Per candidate, how many "does this skill transfer?" questions may be asked.
# Each one is an LLM call. Lower = faster and cheaper, but a candidate whose
# skills are all named unusually gets less credit. 8 is thorough; 3 is brisk.
MAX_TRANSFERABILITY_CALLS=8
# How many CVs are processed at once. Each is mostly waiting on the network,
# so this is limited by the provider's rate limit, not by CPU cores. Lower it
# if the provider starts returning 429 (too many requests).
RANKING_WORKERS=4

# Cache each CV's extraction, keyed by the file's content. An unchanged CV is
# never sent to the LLM twice, so re-running a batch is instant, costs no
# tokens, and produces exactly the same shortlist. Set to 0 to force a fresh
# read every time, or run: python clear_cache.py
EXTRACTION_CACHE=1
EXTRACTION_CACHE_DIR=storage/cache/extractions

# ===========================================================================
# HR policy decisions — confirm these with the HR stakeholder
# ===========================================================================
INTERNSHIP_WEIGHT=0.5
PART_TIME_WEIGHT=0.6

# ===========================================================================
# Who may sign in
# ===========================================================================
# Seeded as administrators on startup. Without at least one, nobody can sign
# in and nobody can grant access — the system locks itself.
ADMIN_EMAILS=you@example.com

# Optional: admit anyone at these domains without listing them individually.
# Leave empty so the list in the database is the only way in.
# ALLOWED_EMAIL_DOMAINS=hondaatlas.com.pk

# Testing only. Admits ANY address. The app shows a warning banner while this
# is on. Never process real candidate CVs with it on.
OPEN_ACCESS=0

# Tell an unlisted visitor plainly that they are not authorised (1), or give
# the same answer either way so nobody can discover who has access (0).
REVEAL_UNAUTHORISED=1

# ===========================================================================
# Sign-in codes and sessions
# ===========================================================================
# Any long random string. Sign-in codes are hashed with it, so a stolen
# database yields no usable codes. Changing it signs everyone out.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

SESSION_HOURS=8
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Set to 1 wherever the site is served over https — that is every deployment.
SESSION_COOKIE_SECURE=0

# ===========================================================================
# Sending the sign-in code
# ===========================================================================
# console -> printed in this terminal. No account needed. Development only.
# resend  -> https://resend.com, 3000 emails a month at no cost
# smtp    -> any mail server, including Gmail with an App Password
EMAIL_PROVIDER=console

# --- Resend ----------------------------------------------------------------
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your_key_here
# Until a domain is verified, Resend only accepts this From address and only
# delivers to your own account's email:
# EMAIL_FROM=CV Shortlist <onboarding@resend.dev>

# --- Gmail (App Password, not your normal password) -------------------------
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# EMAIL_FROM=CV Shortlist <you@gmail.com>

# ===========================================================================
# Phone sign-in (Firebase) — leave empty to hide the phone option entirely
# ===========================================================================
# Path to the service account JSON, or the JSON itself. THIS IS A SECRET.
# FIREBASE_CREDENTIALS=firebase-service-account.json

# ===========================================================================
# Passwords
# ===========================================================================
# A length floor rather than a symbol-and-capital rule: the second mostly
# produces "Password1!", which is on every guessing list.
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_ATTEMPTS=5
PASSWORD_LOCKOUT_MINUTES=15
