# Firebase web config, baked into the deployed build.
#
# NOT secret. A Firebase web config ships inside every page that uses it and
# is readable by anyone who opens the site. What protects the project is the
# authorised-domains list in the Firebase console, plus the fact that our own
# server checks every phone number against the allowed-users list before
# letting anybody in.
#
# The service-account key is the secret one. It never appears here — on the
# Space it goes in FIREBASE_CREDENTIALS as an encrypted Secret.
#
# Vite reads this file during `npm run build`, which is what the Dockerfile
# runs. Local development reads .env instead, which is gitignored.

VITE_FIREBASE_API_KEY=AIzaSyCpWQP_yV9tDt9pYhosCNLfWcTs9Nko1IA
VITE_FIREBASE_AUTH_DOMAIN=caliper-hr.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=caliper-hr
VITE_FIREBASE_APP_ID=1:1066433478233:web:9c92b55872acfa5a89bb48
