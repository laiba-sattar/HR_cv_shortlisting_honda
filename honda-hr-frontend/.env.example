# Firebase web config, for phone sign-in.
#
# Copy this file to .env and fill it in from the Firebase console:
#   Project settings -> General -> Your apps -> Web app -> SDK setup
#
# These are NOT secrets. A Firebase web config is visible inside every page
# that uses it. What protects the project is the authorised-domains list in
# the console, and the fact that our own server checks the phone number
# against the allowed-users list before letting anybody in.
#
# The service-account JSON is a different thing entirely and IS a secret. It
# belongs in cv-model/, referenced by FIREBASE_CREDENTIALS, and never here.
#
# Leave these empty and the phone option simply does not appear. Email
# sign-in works exactly as before.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Point the site at a backend on another address. Leave unset for the normal
# setup: localhost:8000 in development, same origin in a production build.
# VITE_API_URL=
